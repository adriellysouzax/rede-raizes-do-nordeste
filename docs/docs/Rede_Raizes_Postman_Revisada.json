    {
      "name": "Permissões e pagamento recusado",
      "item": [
        {
          "name": "T13 | Login gerente (preparação)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Necessário gerente cadastrado e credenciais configuradas.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{gerenteUsuario}}\",\n  \"senha\": \"{{gerenteSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
