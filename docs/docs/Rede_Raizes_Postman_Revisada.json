{
  "info": {
    "_postman_id": "cdd3883d-9a63-46ea-be45-c054942c7bef",
    "name": "Rede Raízes do Nordeste - API | Revisada",
    "description": "Coleção revisada conforme controllers Java do ZIP fornecido. Executar login antes dos testes protegidos. Testes de pedidos exigem cliente, unidade, produto e estoque válidos. Não contém credenciais reais. Cenários dependentes de dados precisam de preparação manual; não são evidência de execução.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "60200739",
    "_collection_link": "https://go.postman.co/collection/60200739-cdd3883d-9a63-46ea-be45-c054942c7bef?source=collection_link"
  },
  "item": [
    {
      "name": "Autenticação e consultas",
      "item": [
        {
          "name": "T01 | Login admin válido (positivo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{adminUsuario}}\",\n  \"senha\": \"{{adminSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data=pm.response.json();",
                  "pm.test(\"Token recebido\", () => pm.expect(data.token).to.be.a(\"string\").and.not.empty);",
                  "if (data.token) pm.collectionVariables.set(\"adminToken\", data.token);"
                ]
              }
            }
          ]
        },
