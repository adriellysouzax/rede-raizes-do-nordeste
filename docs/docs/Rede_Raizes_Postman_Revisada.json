    {
      "name": "Fluxo principal",
      "item": [
        {
          "name": "T05 | Criar pedido válido (positivo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "description": "Requer clienteId, unidadeId e produtoId existentes com estoque suficiente. Conferir idPedido no retorno.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": \"{{clienteId}}\",\n  \"idUnidade\": \"{{unidadeId}}\",\n  \"itens\": [\n    {\n      \"idProduto\": \"{{produtoId}}\",\n      \"quantidade\": 1\n    }\n  ],\n  \"combos\": [],\n  \"canalPedido\": \"APP\",\n  \"entrega\": false,\n  \"usarPontos\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const p=pm.response.json();",
                  "if (p.idPedido) pm.collectionVariables.set(\"pedidoId\", p.idPedido);"
                ]
              }
            }
          ]
        },
        {
          "name": "T06 | Consultar pedido criado (positivo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}",
            "description": "Executar após T05.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "T07 | Pagamento aprovado (positivo)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/pagamento",
            "description": "Pedido deve estar aguardando pagamento; executar após T05.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resultado\": \"APROVADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
